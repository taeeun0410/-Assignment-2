    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(280,260)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="radix" val="16"/>
      <a name="width" val="25"/>
    </comp>
    <comp lib="0" loc="(600,290)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="labelloc" val="east"/>
      <a name="type" val="output"/>
    </comp>
    <comp loc="(550,260)" name="Assignment2_4"/>
    <wire from="(280,260)" to="(330,260)"/>
    <wire from="(550,260)" to="(600,260)"/>
    <wire from="(600,260)" to="(600,290)"/>
  </circuit>
  <vhdl appearance="logisim_evolution" name="Assignment2_4">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity Assignment2_4 is
    port (
        vote   : in std_logic_vector(24 downto 0);
        result : out std_logic
    );
end entity Assignment2_4;

architecture bhv of Assignment2_4 is
begin
    process(vote)
        variable count : integer range 0 to 25;
    begin
        count := 0;

        for i in 0 to 24 loop
            if vote(i) = '1' then
                count := count + 1;
            end if;
        end loop;

        if count &gt;= 13 then
            result &lt;= '1';
        else
            result &lt;= '0';
        end if;
    end process;
end architecture bhv;</vhdl>
